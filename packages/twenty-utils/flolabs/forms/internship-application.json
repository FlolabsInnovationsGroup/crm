      "required": false,
      "choiceDisplay": "auto",
      "mapTo": "otherSourceDetails",
      "visibleWhenMatch": "all",
      "visibleWhenGroups": [
        {
          "match": "all",
          "conditions": [
            {
              "fieldId": "source",
              "operator": "equals",
              "value": "OTHER"
            }
          ]
        }
      ],
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroups": [
        {
          "match": "all",
          "conditions": [
            {
              "fieldId": "source",
              "operator": "equals",
              "value": "OTHER"
            }
          ]
        }
      ],
