    "logoAlign": "center",
    "buttonAlign": "start",
    "showTitle": true,
    "showProgressBar": true,
    "maxWidthPx": 720
  },
  "settings": {
    "successMessage": "Thank you for applying to FloLabs!\nWe'll email next steps from hr@flolabsinnovations.com.",
