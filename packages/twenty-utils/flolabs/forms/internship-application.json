      "required": true,
      "choiceDisplay": "auto",
      "mapTo": "name.firstName",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "half"
    },
    {
      "id": "last_name",
      "type": "shortText",
      "label": "Last Name",
      "required": true,
      "choiceDisplay": "auto",
      "mapTo": "name.lastName",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "half"
    },
    {
      "id": "email",
