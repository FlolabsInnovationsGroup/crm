      "placeholder": "+1 555 123 4567",
      "required": true,
      "choiceDisplay": "auto",
      "mapTo": "phones.primaryPhoneNumber",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "full"
    },
    {
      "id": "location_education",
