{
  "version": 1,
  "title": "Meeting Recordings",
  "fields": [
    {
      "id": "overview_image",
      "type": "image",
      "label": "FloLabs",
      "required": false,
      "choiceDisplay": "auto",
      "imageUrl": "https://images.fillout.com/orgid-312101/flowpublicid-besSHDQpaHus/widgetid-dUkt/rERbXCmyocCsemDazW3ey3/flomadlabs.jpg?a=nXRyQxJJFe4ugVLyp5Hf5H",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "full"
    },
    {
      "id": "overview_text",
      "type": "paragraph",
      "label": "",
      "description": "Thank you for your interest in FloLabs!\n\nWe're pleased to share some important resources to ensure you're up-to-date on our current projects. The recorded meetings will provide a better idea of our team and where we are with the various projects we are working on.",
      "required": false,
      "choiceDisplay": "auto",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "full"
    },
    {
      "id": "contact_info",
      "type": "pageBreak",
      "label": "Contact Info",
      "required": false,
      "choiceDisplay": "auto",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "full"
    },
    {
      "id": "first_name",
      "type": "shortText",
      "label": "First name",
      "required": true,
      "choiceDisplay": "auto",
      "mapTo": "name.firstName",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "half",
      "prefillQueryParam": "first_name"
    },
    {
      "id": "last_name",
      "type": "shortText",
      "label": "Last name",
      "required": true,
      "choiceDisplay": "auto",
      "mapTo": "name.lastName",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "half",
      "prefillQueryParam": "last_name"
    },
    {
      "id": "email",
      "type": "email",
      "label": "Email",
      "required": true,
      "choiceDisplay": "auto",
      "mapTo": "emails.primaryEmail",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "full",
      "prefillQueryParam": "email"
    },
    {
      "id": "agreement_sign",
      "type": "pageBreak",
      "label": "Agreement Sign",
      "required": false,
      "choiceDisplay": "auto",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "full"
    },
    {
      "id": "agree_review_materials",
      "type": "checkbox",
      "label": "I will read, watch, and review all materials provided to me, ensuring I have the necessary knowledge to fully participate and move forward.",
      "required": true,
      "choiceDisplay": "auto",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "full"
    },
    {
      "id": "agree_thorough_answers",
      "type": "checkbox",
      "label": "I confirm that I will provide thorough, detailed responses that reflect my genuine understanding and commitment to this opportunity.",
      "required": true,
      "choiceDisplay": "auto",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "full"
    },
    {
      "id": "agree_own_work",
      "type": "checkbox",
      "label": "I confirm that the information I provide is my own work and that I will not use AI tools to generate any responses on my behalf.",
      "required": true,
      "choiceDisplay": "auto",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "full"
    },
    {
      "id": "agree_authentic",
      "type": "checkbox",
      "label": "I agree to share my authentic opinions and experiences, offering genuine feedback without embellishment or misrepresentation.",
      "required": true,
      "choiceDisplay": "auto",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "full"
    },
    {
      "id": "agree_commitment",
      "type": "checkbox",
      "label": "I understand that this indicates my commitment to these statements, and I acknowledge that failing to adhere may jeopardize my participation in this opportunity.",
      "required": true,
      "choiceDisplay": "auto",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "full"
    },
    {
      "id": "agree_ceo_review",
      "type": "checkbox",
      "label": "Please note: John Hazlewood, Founder and CEO of FloLabs, will personally review your response prior to his presentation, which you will be invited to attend. Please ensure your answers reflect your genuine reply.",
      "required": true,
      "choiceDisplay": "auto",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "full"
    },
