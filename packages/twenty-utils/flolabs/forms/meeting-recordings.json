      "id": "instructions_confirmed",
      "type": "checkbox",
      "label": "Once you've reviewed the meeting recordings, please document your thoughts on each one and respond to the associated questions. As you'll notice, the interns in the recordings are enthusiastic and eager to learn. We are looking to recruit individuals who share these qualities and want to ensure a strong fit before moving forward. Please be comprehensive with your reply so we can understand that you watched the recordings and we can gauge that you are really interested in this opportunity.",
      "required": true,
      "choiceDisplay": "auto",
      "visibleWhenMatch": "all",
      "visibleWhenGroupsMatch": "any",
      "requiredWhenGroupsMatch": "any",
      "width": "full"
    },
