# Copy to .env on the server only (chmod 600). Never commit .env.
LISTMONK_DB_PASSWORD=
LISTMONK_ADMIN_USER=
LISTMONK_ADMIN_PASSWORD=
# Fixed domains, space-separated. More are added in the CRM: Settings > Sending domains.
# e.g. news.flolabsinnovations.com news.flobrain.ai news.robocollective.ai
SENDING_DOMAINS=
# Must match the server's PTR record set in Hetzner.
MAIL_HOSTNAME=
DKIM_SELECTOR=lm1
SENDING_IPV4=128.140.4.151
SENDING_IPV6=2a01:4f8:1c19:7c31::1
# User the CRM server container runs as; it writes ./domains/domains.txt.
CRM_UID=1000
